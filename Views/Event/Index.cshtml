@model IEnumerable<EventEase.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @ViewBag.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-dark text-white">
        <strong>🔍 Filter Events</strong>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label">Event Type</label>
                    <select name="eventTypeId" class="form-select" asp-items="ViewBag.EventTypeId">
                        <option value="">-- All Types --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Start Date From</label>
                    <input type="date" name="startDate" class="form-control" value="@ViewBag.CurrentStartDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">End Date To</label>
                    <input type="date" name="endDate" class="form-control" value="@ViewBag.CurrentEndDate" />
                </div>

                <div class="col-md-2">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="availableOnly"
                               value="true" id="availableOnly"
                        @(ViewBag.AvailableOnly == true ? "checked" : "") />
                        <label class="form-check-label" for="availableOnly">
                            Available Only
                        </label>
                    </div>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
                </div>

            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Create" class="btn btn-success">+ Add New Event</a>
    <span class="text-muted small">Showing <strong>@Model.Count()</strong> event(s)</span>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Description</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No events match your criteria.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Name</strong></td>
                    <td>
                        @if (item.EventType != null)
                        {
                            <span class="badge bg-info text-dark">@item.EventType.Name</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Unclassified</span>
                        }
                    </td>
                    <td>@item.Description</td>
                    <td>@item.StartDate.ToString("dd MMM yyyy")</td>
                    <td>@item.EndDate.ToString("dd MMM yyyy")</td>
                    <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>