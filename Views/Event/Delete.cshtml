@model EventEase.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Event</h1>

@if (ViewBag.HasBookings == true)
{
    <div class="alert alert-danger" role="alert">
        <strong>⚠ Cannot Delete:</strong> @ViewBag.Warning
        <br />Please cancel or remove all associated bookings before deleting this event.
    </div>

    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
}
else
{
    <h3 class="text-danger">Are you sure you want to delete this event?</h3>

    <div class="card mt-3 mb-4" style="max-width: 500px;">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>

                <dt class="col-sm-4">Start Date</dt>
                <dd class="col-sm-8">@Model.StartDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-4">End Date</dt>
                <dd class="col-sm-8">@Model.EndDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-4">Created At</dt>
                <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="EventId" />
        <input type="submit" value="Yes, Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
}