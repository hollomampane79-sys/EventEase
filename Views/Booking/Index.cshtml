@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<h1>Bookings</h1>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @ViewBag.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search Bar -->
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width: 450px;">
        <input type="text"
               name="searchString"
               value="@ViewBag.CurrentFilter"
               class="form-control"
               placeholder="Search by Booking ID or Event Name..." />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">+ New Booking</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No bookings found matching your search.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Booking ID</th>
                <th>Booking Code</th>
                <th>Event Name</th>
                <th>Venue Name</th>
                <th>Venue Location</th>
                <th>Booking Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>#@item.BookingId</strong></td>
                    <td>
                        <span class="badge bg-secondary">@item.UniqueBookingCode</span>
                    </td>
                    <td>@item.Event?.Name</td>
                    <td>@item.Venue?.Name</td>
                    <td>@item.Venue?.Location</td>
                    <td>@item.BookingDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (item.Status == "Booked")
                        {
                            <span class="badge bg-success">@item.Status</span>
                        }
                        else if (item.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">@item.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@item.Status</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-muted">Showing @Model.Count() booking(s)</p>
}